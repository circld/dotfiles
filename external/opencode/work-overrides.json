{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "octane_llm_proxy": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Octane LLM Proxy",
      "options": {
        "baseURL": "{env:OCTANE_LLM_PROXY_URL}",
        "apiKey": "{env:OCTANE_API_KEY}",
        "litellmProxy": true,
        "timeout": 600000,
        "chunkTimeout": 300000
      },
      "models": {
        "claude-opus-5.5": {
          "name": "Claude Opus 5.5",
          "reasoning": true,
          "cost": {
            "input": 4,
            "output": 20,
            "cache_read": 0.2,
            "cache_write": 5
          },
          "limit": {
            "context": 1000000,
            "output": 128000
          }
        }
      }
    },
    "octane_llm_proxy_openai": {
      "npm": "@ai-sdk/openai",
      "name": "Octane LLM Proxy",
      "options": {
        "baseURL": "{env:OCTANE_LLM_PROXY_URL}",
        "apiKey": "{env:OCTANE_API_KEY}",
        "litellmProxy": true,
        "timeout": 600000,
        "chunkTimeout": 180000
      },
      "models": {
        "gpt-6-luna": {
          "name": "GPT-6 Luna",
          "reasoning": true,
          "cost": {
            "input": 0.09999999999999999,
            "output": 0.5,
            "cache_read": 0.01,
            "cache_write": 0.125
          },
          "limit": {
            "context": 1050000,
            "output": 128000
          }
        },
        "gpt-6-sol": {
          "name": "GPT-6 Sol",
          "reasoning": true,
          "cost": {
            "input": 2,
            "output": 10,
            "cache_read": 0.19999999999999998,
            "cache_write": 2.5
          },
          "limit": {
            "context": 1050000,
            "output": 128000
          }
        }
      }
    }
  },
  "tools": {
    "websearch_*": false
  },
  "agent": {
    "explore": {
      "model": "octane_llm_proxy_openai/gpt-6-luna",
      "variant": "low"
    },
    "general": {
      "model": "octane_llm_proxy_openai/gpt-6-luna",
      "variant": "low"
    },
    "researcher": {
      "model": "octane_llm_proxy_openai/gpt-6-luna",
      "tools": {
        "websearch_*": true
      }
    },
    "code-reviewer": {
      "model": "octane_llm_proxy_openai/gpt-6-sol",
      "mode": "subagent"
    },
    "task-implementer": {
      "model": "octane_llm_proxy_openai/gpt-6-luna",
      "mode": "subagent",
      "variant": "low"
    },
    "spec-reviewer": {
      "model": "octane_llm_proxy_openai/gpt-6-sol",
      "mode": "subagent"
    },
    "doc-critic": {
      "model": "octane_llm_proxy/claude-opus-5.5",
      "mode": "subagent"
    },
    "doc-updater": {
      "model": "octane_llm_proxy_openai/gpt-6-sol",
      "mode": "subagent"
    }
  },
  "mcp": {
    "confluence": {
      "type": "remote",
      "url": "{env:OCTANE_MCP_BASE_URL}/mcp/confluence",
      "enabled": true,
      "headers": {
        "OCTANE_API_KEY": "{env:OCTANE_API_KEY}"
      }
    },
    "jira": {
      "type": "remote",
      "url": "{env:OCTANE_MCP_BASE_URL}/mcp/jira",
      "enabled": true,
      "headers": {
        "OCTANE_API_KEY": "{env:OCTANE_API_KEY}"
      }
    },
    "librarian": {
      "type": "remote",
      "url": "https://tools.ai-dev.octane.co/mcp/librarian",
      "headers": {
        "OCTANE_API_KEY": "{env:OCTANE_API_KEY}"
      }
    }
  }
}
